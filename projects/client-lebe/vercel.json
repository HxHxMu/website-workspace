{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "src",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/product.*",
      "dest": "/product.html"
    },
    {
      "src": "/cart.*",
      "dest": "/cart.html"
    },
    {
      "src": "/(.*\\..*)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
