# Printful API Configuration
# Get your API key from: https://www.printful.com/admin/settings/api
PRINTFUL_API_KEY=your_printful_api_key_here
PRINTFUL_WEBHOOK_SECRET=generate_a_long_random_token

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Meta Pixel
# Used at build time to inject the browser Pixel snippet into generated HTML.
META_PIXEL_ID=1697401754023773

# Meta Conversions API (server-side)
# Events Manager -> your pixel -> Settings -> Conversions API -> Generate access token.
META_CAPI_TOKEN=your_meta_capi_access_token

# Pinterest Tag
# Business account -> Ads -> Conversions -> install the tag -> copy the Tag ID.
PINTEREST_TAG_ID=your_pinterest_tag_id

# Klaviyo (footer email capture)
# klaviyo.com -> Settings -> Account -> your Public API Key (company_id) and target List ID.
# Leave unset to hide the footer signup field entirely.
# KLAVIYO_COMPANY_ID=
# KLAVIYO_LIST_ID=

# Admin-only manual recovery for paid Stripe PaymentIntents that need Printful fulfillment retry
FULFILLMENT_ADMIN_TOKEN=generate_a_long_random_token
